# Copia este archivo como .env y rellena los dos valores.
# Los sacas de Supabase: tu proyecto > Settings > API.
#
# IMPORTANTE: el archivo .env NO se sube a GitHub (está en .gitignore).
# Trata la llave como una contraseña: no la pegues en chats compartidos.
#
# Si dejas esto vacío, la aplicación arranca igual en modo demo,
# con datos de ejemplo que se borran al recargar.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
